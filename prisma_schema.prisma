generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           Int      @id @default(autoincrement())
  username     String   @unique
  password     String
  nama         String
  role         String
  createdAt    DateTime @default(now())
  voter        Voter?
  activityLogs ActivityLog[]
}

model Candidate {
  id         Int        @id @default(autoincrement())
  nomorUrut  Int        @unique
  namaKetua  String
  namaWakil  String
  visi       String
  misi       String
  fotoUrl    String?
  suaraCount Int        @default(0)
  createdAt  DateTime   @default(now())
  votes      VoteAudit[]
}

model Voter {
  id        Int       @id @default(autoincrement())
  nisn      String    @unique
  nama      String
  kelas     String
  token     String?
  hadir     Boolean   @default(false)
  hasVoted  Boolean   @default(false)
  votedAt   DateTime?
  hadirAt   DateTime?
  userId    Int?      @unique
  user      User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
}

model VoteAudit {
  id             Int       @id @default(autoincrement())
  candidateId    Int
  waktuCoblos    DateTime  @default(now())
  kodeVerifikasi String    @unique
  candidate      Candidate @relation(fields: [candidateId], references: [id], onDelete: Restrict)
}

model ElectionConfig {
  id          Int       @id @default(1)
  nama        String    @default("Pemilihan OSIS & MPK")
  mulaiAt     DateTime?
  selesaiAt   DateTime?
  isOpen      Boolean   @default(false)
  updatedAt   DateTime  @updatedAt
}

model ActivityLog {
  id        Int      @id @default(autoincrement())
  userId    Int?
  aksi      String
  detail    String
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
}
