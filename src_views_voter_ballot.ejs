<%- include('src_views_partials_head') %><%- include('src_views_partials_nav') %>
<main class="page-wrap ballot-wrap"><div class="ballot-heading"><div><p class="eyebrow">SURAT SUARA · KETUA OSIS & MPK</p><h1>Pilih pasangan calon</h1><p class="muted">Halo, <%= voter.nama %>. Tentukan satu pilihan Anda.</p></div><div class="ballot-step"><span class="step-current">01</span><span>MEMILIH</span></div></div>
<form action="/pemilih/coblos" method="post" id="ballot-form"><div class="ballot-grid"><% candidates.forEach(candidate => { %><label class="ballot-option"><input type="radio" name="candidateId" value="<%= candidate.id %>" required><article class="ballot-card"><div class="ballot-photo-wrap"><% if (candidate.fotoUrl) { %><img class="ballot-photo" src="<%= candidate.fotoUrl %>" alt="Pasangan calon nomor <%= candidate.nomorUrut %>" loading="lazy"><% } else { %><div class="photo-placeholder"><%= String(candidate.nomorUrut).padStart(2,'0') %></div><% } %><span class="candidate-tag">NOMOR URUT <%= String(candidate.nomorUrut).padStart(2,'0') %></span><span class="selected-indicator">✓</span></div><div class="ballot-copy"><h2><%= candidate.namaKetua %><br><span>& <%= candidate.namaWakil %></span></h2><div class="platform-copy"><strong>VISI</strong><p><%= candidate.visi %></p><strong>MISI</strong><p><%= candidate.misi %></p></div></div></article></label><% }); %></div><div class="ballot-submit"><span class="muted">Pilihan tidak dapat diubah setelah dikonfirmasi.</span><button class="button button-primary" type="submit">Konfirmasi coblos <span>→</span></button></div></form></main><script>document.getElementById('ballot-form').addEventListener('submit', (event) => { if (!confirm('Konfirmasi pilihan Anda? Suara tidak dapat diubah setelah dikirim.')) event.preventDefault(); });</script><%- include('src_views_partials_foot') %>
