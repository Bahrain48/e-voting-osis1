<%- include('src_views_partials_head') %><%- include('src_views_partials_nav') %>
<main class="page-wrap"><div class="page-heading"><div><p class="eyebrow">OPERASIONAL TPS 01</p><h1>Meja panitia</h1><p class="muted">Verifikasi pemilih hadir dan serahkan token satu kali.</p></div><a href="/panitia/berita-acara" class="button button-dark">Berita acara <span>↗</span></a></div>
<section class="stat-grid stat-grid-three"><article class="stat-card"><span class="stat-label">DAFTAR PEMILIH</span><strong><%= voters.length %></strong><span class="stat-foot">nama di DPT</span></article><article class="stat-card"><span class="stat-label">SUDAH MEMILIH</span><strong><%= votedTotal %></strong><span class="stat-foot">hak pilih tercatat</span></article><article class="stat-card"><span class="stat-label">STATUS SESI</span><strong><%= config?.isOpen ? 'Terbuka' : 'Terkunci' %></strong><span class="stat-foot">dikelola administrator</span></article></section>
<section class="surface attendance-surface"><div class="section-heading"><div><p class="eyebrow">VERIFIKASI KEHADIRAN</p><h2>Cari pemilih DPT</h2></div><span class="badge badge-blue">Panitia TPS</span></div><form action="/panitia/kehadiran" method="post" class="attendance-form"><label for="nisn-check">NISN pemilih</label><div class="input-action"><input id="nisn-check" name="nisn" inputmode="numeric" placeholder="Masukkan NISN" required><button class="button button-primary" type="submit">Verifikasi hadir</button></div></form></section>
<section class="surface"><div class="section-heading"><div><p class="eyebrow">DAFTAR PEMILIH TETAP</p><h2>Pemilih terdaftar</h2></div><span class="muted">Token hanya ditampilkan sekali saat diterbitkan.</span></div><div class="table-wrap"><table><thead><tr><th>Pemilih</th><th>NISN</th><th>Kelas</th><th>Kehadiran</th><th>Hak pilih</th><th>Tindakan</th></tr></thead><tbody><% voters.forEach(voter => { %><tr><td><strong><%= voter.nama %></strong></td><td class="mono"><%= voter.nisn %></td><td><%= voter.kelas %></td><td><span class="badge <%= voter.hadirAt ? 'badge-green' : 'badge-yellow' %>"><%= voter.hadirAt ? 'Hadir' : 'Belum hadir' %></span></td><td><span class="badge <%= voter.hasVoted ? 'badge-green' : 'badge-neutral' %>"><%= voter.hasVoted ? 'Sudah memilih' : 'Belum memilih' %></span></td><td><% if (voter.hadirAt && !voter.hasVoted) { %><form action="/panitia/token/<%= voter.id %>" method="post"><button class="button button-small button-outline" type="submit">Terbitkan token</button></form><% } else if (voter.hasVoted) { %><span class="muted">Selesai</span><% } else { %><span class="muted">Verifikasi dulu</span><% } %></td></tr><% }); %></tbody></table></div></section>
</main><%- include('src_views_partials_foot') %>
