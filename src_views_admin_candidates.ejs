<%- include('src_views_partials_head') %><%- include('src_views_partials_nav') %>
<main class="page-wrap"><div class="page-heading"><div><p class="eyebrow">DATA PEMILIHAN</p><h1>Pasangan calon</h1><p class="muted">Kelola profil dan program kerja setiap pasangan.</p></div><span class="badge badge-neutral"><%= candidates.length %> paslon</span></div>
<div class="candidate-admin-grid"><section class="surface"><div class="section-heading"><div><p class="eyebrow">TAMBAH DATA</p><h2>Pasangan baru</h2></div><span class="step-mark">01</span></div><form action="/admin/kandidat" method="post" class="form-stack compact-form"><label>Nomor urut<input type="number" min="1" name="nomorUrut" required></label><div class="two-fields"><label>Nama ketua<input name="namaKetua" required></label><label>Nama wakil<input name="namaWakil" required></label></div><label>Foto URL<input type="url" name="fotoUrl" placeholder="https://..."></label><label>Visi<textarea name="visi" rows="3" required></textarea></label><label>Misi<textarea name="misi" rows="4" required></textarea></label><button class="button button-primary" type="submit">Simpan pasangan calon</button></form></section>
<section class="candidate-admin-list"><% candidates.forEach(candidate => { %><article class="candidate-edit surface"><div class="candidate-edit-head"><div class="candidate-number"> <%= String(candidate.nomorUrut).padStart(2,'0') %></div><div><p class="eyebrow">PASANGAN CALON</p><h2><%= candidate.namaKetua %> & <%= candidate.namaWakil %></h2><span class="muted"><%= candidate.suaraCount %> suara tercatat</span></div></div><form action="/admin/kandidat/<%= candidate.id %>" method="post" class="form-stack compact-form"><div class="two-fields"><label>Nomor urut<input type="number" min="1" name="nomorUrut" value="<%= candidate.nomorUrut %>" required></label><label>Foto URL<input type="url" name="fotoUrl" value="<%= candidate.fotoUrl || '' %>"></label></div><div class="two-fields"><label>Nama ketua<input name="namaKetua" value="<%= candidate.namaKetua %>" required></label><label>Nama wakil<input name="namaWakil" value="<%= candidate.namaWakil %>" required></label></div><label>Visi<textarea name="visi" rows="2" required><%= candidate.visi %></textarea></label><label>Misi<textarea name="misi" rows="3" required><%= candidate.misi %></textarea></label><div class="button-row"><button class="button button-outline" type="submit">Simpan perubahan</button><button class="button button-danger" type="submit" formaction="/admin/kandidat/<%= candidate.id %>/hapus" formmethod="post" onclick="return confirm('Hapus pasangan calon ini?')">Hapus</button></div></form></article><% }); %></section></div>
</main><%- include('src_views_partials_foot') %>
